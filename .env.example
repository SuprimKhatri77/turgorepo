# Local development settings. Copy to the repo root: cp .env.example .env.local
#
# The URLs below work for anything run on your machine. docker-compose.dev.yml
# overrides the ones that need Docker hostnames, so this one file covers both.

# --- API ---
PORT=5000
GIN_MODE=debug

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/turgorepo?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Fine for local use, but release mode refuses to start with them.
# Generate real values with: openssl rand -base64 48
JWT_REFRESH_SECRET=refresh-secret
JWT_ACCESS_SECRET=access-secret

FRONTEND_URL=http://localhost:3000
COOKIE_DOMAIN=localhost
OPENAPI_PATH=openapi.json

# Comma-separated CIDRs of proxies allowed to set X-Forwarded-For, such as your
# VPC range behind an AWS load balancer. Leave empty when there is no proxy, or
# clients can fake their IP and get around rate limits.
TRUSTED_PROXIES=

# Optional. Set all three to enable image uploads.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:5000
INTERNAL_API_URL=http://localhost:5000

# --- Postgres container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=turgorepo

# --- Docker host ports ---
# Change these if something else is using a port, then update the URLs above
# (DATABASE_URL, REDIS_URL, FRONTEND_URL, NEXT_PUBLIC_API_URL, INTERNAL_API_URL).
# Without Docker, the API listens on PORT instead of API_PORT.
# WEB_PORT=3000
# API_PORT=5000
# DB_PORT=5432
# REDIS_PORT=6379

# --- Seed users (bun run db:seed) ---
# Local only. Seeding refuses change-me passwords in release mode.
SEED_ADMIN_PASSWORD=change-me-admin
SEED_MEMBER_PASSWORD=change-me-member
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_MEMBER_EMAIL=member@example.com

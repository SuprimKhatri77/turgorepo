{
  "name": "turgorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:go": "cd apps/api && golangci-lint run ./...",
    "test:go": "cd apps/api && go test ./...",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml,css}\"",
    "check-types": "turbo run check-types",
    "generate": "turbo run generate",
    "generate:check": "bun run scripts/check-generated.ts",
    "db:migrate": "cd apps/api && make migrate-up",
    "db:migrate:down": "cd apps/api && make migrate-down",
    "db:sqlc": "cd apps/api && make sqlc",
    "db:sqlc:check": "bun run scripts/check-sqlc.ts",
    "db:seed": "cd apps/api && make seed",
    "docker:dev:up": "docker compose --env-file .env.local -f docker-compose.dev.yml up --build --renew-anon-volumes --detach --wait",
    "docker:dev:down": "docker compose --env-file .env.local -f docker-compose.dev.yml down",
    "prepush": "bun run check-types && bun run lint:go && bun run test:go && bun run build",
    "ci": "bun run generate:check && bun run db:sqlc:check && bun run check-types && bun run lint && bun run lint:go && bun run test:go && bun run build",
    "prepare": "husky",
    "docker:dev:services": "docker compose --env-file .env.local -f docker-compose.dev.yml up --detach --wait db redis mailpit",
    "docker:dev:logs": "docker compose --env-file .env.local -f docker-compose.dev.yml logs --follow",
    "start": "turbo run start",
    "docker:build:api": "docker build -t turgorepo-api apps/api",
    "docker:build:web": "docker build --build-arg NEXT_PUBLIC_API_URL -f apps/web/Dockerfile -t turgorepo-web .",
    "init": "bun run scripts/init-project.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}

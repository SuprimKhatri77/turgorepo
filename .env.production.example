# Production settings. Copy to .env.production for docker-compose.prod.yml. On AWS,
# set these on the ECS tasks, and keep secrets in Secrets Manager.

# --- API ---
# Neon: use the pooled URL here. RDS: use the instance URL.
# The values below match the local-deps profile.
DATABASE_URL=postgresql://postgres:postgres@db:5432/turgorepo?sslmode=disable
# Direct (not pooled) connection, because migrations need locks. Defaults to DATABASE_URL.
# MIGRATE_DATABASE_URL=
# ElastiCache or Upstash with TLS: rediss://...
REDIS_URL=redis://redis:6379/0

# Required. Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Exact origin of the web app.
FRONTEND_URL=https://app.example.com
# Shared parent domain of the web app and API.
COOKIE_DOMAIN=.example.com
# The load balancer's address range, such as your VPC CIDR. Required behind a proxy,
# or every request appears to come from the proxy and shares one rate limit.
TRUSTED_PROXIES=10.0.0.0/16

# Required, because password reset depends on email. Works with any SMTP service.
# Amazon SES: SMTP_HOST=email-smtp.<region>.amazonaws.com, SMTP_PORT=587, and SMTP
# credentials from the SES console. The values below match the local-deps profile.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
# Local testing only, because Mailpit has no TLS. Remove this for a real deployment.
SMTP_ALLOW_PLAINTEXT=true

# Optional. Set all three to enable image uploads.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Serves /api/v1/docs. Off by default in production.
# DOCS_ENABLED=true

# --- Web ---
# Browser-facing API URL, built into the web image.
NEXT_PUBLIC_API_URL=https://api.example.com
# API URL for server-side web requests.
INTERNAL_API_URL=http://api:5000

# --- Host ports for docker-compose.prod.yml ---
# WEB_PORT=3000
# API_PORT=5000
